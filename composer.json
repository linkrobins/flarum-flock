{
    "name": "linkrobins/flarum-flock",
    "description": "Paid memberships for Flarum. Your Stripe, your money, your groups.",
    "keywords": [
        "flarum",
        "flock",
        "memberships",
        "subscriptions",
        "stripe"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "stripe/stripe-php": "^21.2"
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0"
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Karl Bullock",
            "email": "karl@linkrobins.com"
        }
    ],
    "support": {
        "issues": "https://github.com/linkrobins/flarum-flock/issues",
        "source": "https://github.com/linkrobins/flarum-flock",
        "forum": "https://linkrobins.com/forum",
        "email": "karl@linkrobins.com"
    },
    "homepage": "https://linkrobins.com/flock",
    "autoload": {
        "psr-4": {
            "LinkRobins\\Flock\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LinkRobins\\Flock\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Flock",
            "category": "feature",
            "icon": {
                "name": "fas fa-feather",
                "backgroundColor": "#c88e09",
                "color": "#fff"
            }
        },
        "flarum-cli": {
            "modules": {
                "admin": true,
                "forum": true,
                "js": true,
                "jsCommon": false,
                "css": true,
                "locale": true,
                "gitConf": true,
                "githubActions": true,
                "prettier": true,
                "typescript": true,
                "bundlewatch": false,
                "backendTesting": true,
                "editorConfig": true,
                "styleci": false
            }
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    }
}
